@page "/Forums"
@model ForumsModel
@{ ViewData["Title"] = "Forums"; }
<h1>Forum</h1>
@foreach (var forum in Model.Items)
{
    <partial name="/Pages/Forums/_ForumCard.cshtml" model="forum" />

    <a asp-page="/Forums/Details"
       asp-route-id="@forum.Id"
       class="btn btn-primary">
        View Discussions
    </a>
}
