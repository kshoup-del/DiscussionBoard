@page "/Forum/{id:int}"
@model DiscussionBoard.Pages.Forums.DetailsModel

@{
    ViewData["Title"] = Model.Forum?.Name ?? "Forum Details";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1>@Model.Forum!.Name</h1>
        <p>@Model.Forum.Description</p>
    </div>

    <hr />

    <h2>Discussions</h2>

    @if (Model.Threads.Count == 0)
    {
        <p>No discussions have been created in this forum yet.</p>
    }
    else
    {
        @foreach (var thread in Model.Threads)
        {
            <partial name="_ThreadCard" model="thread" />
        }
    }

    <a asp-page="/Forums/Index" class="btn btn-secondary mt-3">
        Back to Forums
    </a>
</div>
