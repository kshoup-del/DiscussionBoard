@page "/Forum/{id:int}"
@model DiscussionBoard.Pages.Forums.DetailsModel

@{
    ViewData["Title"] = Model.Forum?.Name ?? "Forum";
}

<h1>@Model.Forum?.Name</h1>

<p>@Model.Forum?.Description</p>

<hr />

<h2>Discussions</h2>

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-page="/Discussions/Create"
       asp-route-forumId="@Model.Forum.Id"
       class="btn btn-primary mb-3">
        Create Discussion
    </a>
}

@if (Model.Threads.Count == 0)
{
    <p>No discussions have been created yet.</p>
}

@foreach (var thread in Model.Threads)
{
    <partial name="/Pages/Forums/_ThreadCard.cshtml"
             model="thread" />
}

<a asp-page="/Forums/Index" class="btn btn-secondary">
    Back to Forums
</a>
